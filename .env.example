# ============================================
# WILDFIRE SENTINEL AI
# Environment Variables Example
# ============================================
#
# 1. Copy this file as .env
# 2. Fill in your real values
# 3. Never commit .env (it is in .gitignore)
#
# ============================================
# N8N
# ============================================

# Required so Code and HTTP nodes can read $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ============================================
# GEMINI AI (text classification + vision)
# ============================================

GEMINI_API_KEY=

# ============================================
# META / WHATSAPP BUSINESS API
# ============================================

META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================
# GOOGLE MAPS (geocoding + reverse geocoding)
# ============================================

GOOGLE_MAPS_API_KEY=

# ============================================
# SUPERVISOR
# ============================================

# Phone number with country code, digits only. Example: 34600000000
SUPERVISOR_WHATSAPP=
SUPERVISOR_EMAIL=

# ============================================
# FIRE CREWS (weather alerts)
# ============================================

# Must be a JSON array of phone numbers
# Example: BRIGADISTAS_WHATSAPP=["34600000000","34600000001"]
BRIGADISTAS_WHATSAPP=

# ============================================
# RATE LIMIT
# ============================================

RATE_LIMIT_PER_MINUTE=15

# Minutes a case waits for the user's location before expiring
PENDING_STATE_TTL_MINUTES=30

# Hours before repeating a weather alert at the same (or lower) level
ALERT_COOLDOWN_HOURS=12

# NOTE: OpenWeatherMap is configured as an n8n credential, not here.
